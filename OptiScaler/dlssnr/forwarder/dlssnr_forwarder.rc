// Version resource of nvngx.dll_dlssnr.dll: the fork's release number from OptiScaler's resource.h, so it follows every
// release bump. Build date and commit are not used here; _DEBUG makes resource.h skip the two headers OptiScaler's own
// pre-build step writes, which this project must not wait for.
#include <winver.h>

#ifndef _DEBUG
#define _DEBUG
#endif
#include "../../resource.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_FILE_VERSION
PRODUCTVERSION VER_FILE_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OptiScaler-NR"
            VALUE "FileDescription", "Neural Rendering forwarder for OptiScaler"
            VALUE "FileVersion", VER_FILE_VERSION_STR "\0"
            VALUE "InternalName", "nvngx.dll_dlssnr"
            VALUE "OriginalFilename", "nvngx.dll_dlssnr.dll"
            VALUE "ProductName", "OptiScaler F5 Neural Rendering forwarder"
            VALUE "ProductVersion", VER_FILE_VERSION_STR "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
